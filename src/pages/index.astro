---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Writing from '../components/Writing.astro';
import TravelSection from '../components/TravelSection.astro';
import { site } from '../data/site';
import Arrow from '../components/Arrow.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const contactLinks = [
  site.email && { label: 'Email me', href: `mailto:${site.email}` },
  site.github && { label: 'GitHub', href: site.github },
  site.linkedin && { label: 'LinkedIn', href: site.linkedin },
].filter((link): link is { label: string; href: string } => Boolean(link));
---
<Layout>
  <Hero />
  <section id="projects" class="section work-section" aria-labelledby="work-title">
    <div class="container">
      <div class="section-heading"><h2 id="work-title">Built for<br />real people.</h2><p>From production AI to a business's next returning customer. A few things I've helped bring into the world.</p></div>
      <div class="project-list">
        {projects.map((project) => (
          <article class="project-row">
            <div class="project-intro"><h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3><p class="project-role">{project.data.role}</p><ul class="technology-list" aria-label="Technologies">{project.data.technologies.map((technology) => <li>{technology}</li>)}</ul></div>
            <div class="project-story">
              {project.id === 'internal-ai-platform' ? <><p>AI tools only become useful when they fit into real work. I own and lead the engineering of an internal platform at D&B, from its core workflows to the safeguards around them.</p><p class="project-result">Role-based access, observability, and human-in-the-loop workflows. In production and part of my colleagues' day.</p></> : <><p>I cofounded a B2B loyalty platform that helps businesses give their customers a reason to come back, and helped build it from the first idea to real use.</p><p class="project-result">5+ business clients. 300+ active users. $11,000+ in rewards-driven sales.</p></>}
              <a class="text-link" href={`/projects/${project.id}/`}>Read the project <Arrow /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section id="about" class="section about-section" aria-labelledby="about-title">
    <div class="container about-layout">
      <div class="about-heading"><h2 id="about-title">The best part?<br />More builders.</h2><p>UF alum. Former Open Source Club president. Always excited to help someone ship their first thing.</p></div>
      <div class="about-story"><p class="large-copy">Thirty children. Their first websites. That's the workshop I keep coming back to.</p><p>I led a free HTML/CSS workshop for 30 children and helped them deploy their first websites. Helping someone turn an idea into a thing they can share is one of my proudest accomplishments.</p><p>That same energy shaped my time leading the University of Florida Open Source Club: growing from 4 to over 300 members and running UF's first open source hackathon, with over 200 participants.</p><p class="about-closing">I like building things. I love seeing other people become builders.</p></div>
    </div>
  </section>
  <section id="blog" class="section writing-section" aria-labelledby="writing-title"><div class="container writing-layout"><div><h2 id="writing-title">Notes along<br />the way.</h2></div><div><Writing onHomepage /></div></div></section>
  <TravelSection />
  <section id="contact" class="section contact-section" aria-labelledby="contact-title"><div class="container contact-inner"><div><h2 id="contact-title">Something in mind?<br />Let's make it useful.</h2><p>I'm always interested in thoughtful projects and people who like to build.</p></div><div class="contact-links">{contactLinks.length ? contactLinks.map((link) => <a class="button button-primary" href={link.href}>{link.label}<Arrow /></a>) : <p class="contact-preview">Contact links are coming soon.<br />This little corner is still taking shape.</p>}</div></div></section>
</Layout>
