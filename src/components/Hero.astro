---
// Interim text-first foundation; the approved basecamp artwork arrives in Task 2.
import Arrow from './Arrow.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title">My favorite part is seeing people use it.</h1>
      <p class="hero-description">I build AI tools at D&B. What keeps me building is watching something I made become part of someone's day.</p>
      <p class="hero-credentials">AI Engineer at D&B <span aria-hidden="true">·</span> UF alum</p>
      <div class="hero-actions"><a class="button button-primary" href="#projects">Explore my work <Arrow direction="down-right" /></a><a class="text-link" href="#contact">Say hello <Arrow /></a></div>
    </div>
  </div>
</section>
